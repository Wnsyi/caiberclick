# ===== 服务端 =====
# Express 服务器端口
PORT=8081

# 前端资源路径
BASE_PATH=/
VITE_BASE_PATH=/

# MySQL 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=CaiberClick_db

# AI 大模型 API 配置 — 请在 .env.local 中配置真实密钥（不会提交到 git）
AI_API_BASE=
AI_API_KEY=
AI_MODEL=deepseek-chat

# ===== 前端（Vite 构建时注入到浏览器代码）=====
# 前端直连 AI API 的配置 — 请在 .env.local 中配置真实值
VITE_AI_API_BASE=
VITE_AI_API_KEY=
VITE_AI_MODEL=deepseek-chat
