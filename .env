# ===== 服务端 =====
# Express 服务器端口
PORT=3000

# 前端资源路径：交作业时用 /  ，部署到 CloudBase 时改成 /mental-hospital/
BASE_PATH=/
VITE_BASE_PATH=/

# ===== 前端（Vite 构建时注入到浏览器代码） =====
# CloudBase（腾讯云开发）环境 ID
# 用于：体验人数统计、问诊记录保存、处方数据保存
VITE_CLOUDBASE_ENV_ID=game-one-d1gx1gwhbee34fff7

# AI 大模型 API 配置 — 请在 .env.local 中配置真实密钥（不会提交到 git）
AI_API_BASE=
AI_API_KEY=
AI_MODEL=ds
